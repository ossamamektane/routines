{
  "expo": {
    "name": "FacеTime",
    "slug": "calls",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.ossamamektane.calls",
      "supportsTablet": false,
      "buildNumber": "1",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSMicrophoneUsageDescription": "Used during calls.",
        "NSCameraUsageDescription": "Used to take photos.",
        "NSPhotoLibraryUsageDescription": "Used to choose photos.",
        "NSUserActivityTypes": [
          "INStartCallIntent",
          "INStartAudioCallIntent"
        ]
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 1,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "./plugins/with-quick-call",
      "./plugins/with-call-sounds"
    ]
  }
}
